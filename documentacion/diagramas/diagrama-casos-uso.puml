@startuml
title Diagrama de casos de uso - Sistema de Gestión Policial

left to right direction
skinparam dpi 160
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam linetype polyline
skinparam usecase {
  BackgroundColor #F4F7FB
  BorderColor #4E6E9E
  ArrowColor #526D82
}
skinparam rectangle {
  BorderColor #385170
}

actor Investigador as Inv
actor Vigilante as Vig

rectangle "Sistema de Gestión Policial" {
  package "Acceso común" #EDF4FF {
    usecase "Iniciar sesión" as Login
    usecase "Cerrar sesión" as Logout
    usecase "Consultar mi perfil" as Perfil
    usecase "Cambiar mi contraseña" as Password
  }
  package "Consultas" #EFFAF2 {
    usecase "Consultar usuarios\ny roles" as ConsultarUsuarios
    usecase "Consultar información\npolicial, judicial y bancaria" as ConsultarGeneral
    usecase "Consultar mis contratos" as MisContratos
  }
  package "Administración" #FFF4E8 {
    usecase "Administrar usuarios\ny roles" as Usuarios
    usecase "Administrar vigilantes" as Vigilantes
    usecase "Administrar entidades bancarias\ny sucursales" as Bancos
    usecase "Administrar contratos\nde vigilancia" as Contratos
    usecase "Administrar bandas\ny asaltantes" as Delincuentes
    usecase "Registrar y administrar\nasaltos" as Asaltos
    usecase "Administrar jueces" as Jueces
    usecase "Administrar casos\njudiciales" as Casos
    usecase "Registrar y modificar\nsentencias" as Sentencias
  }
}

actor Administrador as Admin

Login -- Admin
Logout -- Admin
Perfil -- Admin
Password -- Admin
ConsultarUsuarios -- Admin
ConsultarGeneral -- Admin
Usuarios -- Admin
Vigilantes -- Admin
Bancos -- Admin
Contratos -- Admin
Delincuentes -- Admin
Asaltos -- Admin
Jueces -- Admin
Casos -- Admin
Sentencias -- Admin

Inv -- Login
Inv -- Logout
Inv -- Perfil
Inv -- Password
Inv -- ConsultarUsuarios
Inv -- ConsultarGeneral

Vig -- Login
Vig -- Logout
Vig -- Perfil
Vig -- Password
Vig -- MisContratos

note left of Inv
  Rol inicial:
  LECTURA
end note
note left of Vig
  Rol inicial:
  LECTURA_DATOS_PROPIOS
end note
note bottom of Usuarios
  Pueden crearse nuevos roles
  combinando permisos existentes.
end note

note right of Admin
  Rol inicial:
  LECTURA + ESCRITURA
end note

@enduml

