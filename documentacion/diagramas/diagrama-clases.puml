@startuml
title Diagrama de clases - Sistema de Gestión Policial

top to bottom direction
skinparam dpi 160
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 45
skinparam ranksep 65
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #385170
  ArrowColor #526D82
}
hide empty members
hide circle

abstract class EntidadAuditable {
  - fechaCreacion : LocalDateTime
  - fechaModificacion : LocalDateTime
  - creadoPor : String
  - modificadoPor : String
}

note right of EntidadAuditable
  Superclase de las entidades persistentes.
  En los grupos se indica la herencia con
  el estereotipo <<EntidadAuditable>> para
  evitar cruces innecesarios.
end note

package "Usuarios y seguridad" #EAF3FF {
  abstract class Usuario <<EntidadAuditable>> {
    - id : Long
    - codigo : String
    - nombre : String
    - password : String
    - activo : boolean
    - motivoBaja : MotivoBajaPersona
  }
  class UsuarioGenerico
  class Vigilante {
    - edad : int
  }
  class Rol <<EntidadAuditable>> {
    - id : Long
    - codigo : String
    - nombre : String
    - prefijo : String
    - descripcion : String
    - activo : Boolean
  }
  enum Permiso {
    LECTURA
    ESCRITURA
    LECTURA_DATOS_PROPIOS
  }
  Usuario <|-- UsuarioGenerico
  Usuario <|-- Vigilante
  Usuario "0..*" --> "1" Rol : posee
  Rol "1" o-- "1..*" Permiso : contiene
}

package "Actividad bancaria" #EFFAF2 {
  class EntidadBancaria <<EntidadAuditable>> {
    - id : Long
    - codigo : String
    - nombre : String
    - domicilioCentral : String
    - activo : boolean
    - motivoBaja : MotivoBajaEntidadBancaria
  }
  class Sucursal <<EntidadAuditable>> {
    - id : Long
    - codigo : String
    - domicilio : String
    - cantEmpleados : Integer
    - activo : boolean
    - motivoCierre : MotivoCierreSucursal
  }
  class ContratoVigilancia <<EntidadAuditable>> {
    - id : Long
    - codigo : String
    - fecha : LocalDate
    - conArma : Boolean
    - activo : Boolean
    - motivoBaja : MotivoBajaContrato
  }
  EntidadBancaria "1" -- "0..*" Sucursal : posee
}

package "Investigación policial" #FFF6E8 {
  class Banda <<EntidadAuditable>> {
    - id : Long
    - codigo : String
    - cantMiembros : int
    - activo : boolean
  }
  class Asaltante <<EntidadAuditable>> {
    - id : Long
    - codigo : String
    - nombre : String
    - activo : boolean
    - motivoBaja : MotivoBajaPersona
  }
  class Asalto <<EntidadAuditable>> {
    - id : Long
    - codigo : String
    - fecha : LocalDate
    + cambiarSucursal(sucursal : Sucursal) : void
    + agregarAsaltante(asaltante : Asaltante) : void
    + quitarAsaltante(asaltante : Asaltante) : void
  }
  Banda "0..1" -- "0..*" Asaltante : agrupa
  Asalto "0..*" -- "1..*" Asaltante : participantes
}

package "Actividad judicial" #F4EEFF {
  class Juez <<EntidadAuditable>> {
    - id : Long
    - codigo : String
    - nombre : String
    - juezDesde : LocalDate
    - activo : boolean
    - motivoBaja : MotivoBajaPersona
  }
  class CasoJudicial <<EntidadAuditable>> {
    - id : Long
    - codigo : String
    - activo : boolean
    - sentenciado : boolean
    - estado : EstadoCasoJudicial
    - motivoReapertura : String
    + cambiarJuez(nuevoJuez : Juez) : void
    + reabrirPorApelacion(motivo : String) : void
    + cerrarAutomaticamente() : void
  }
  class SentenciaAsaltante <<EntidadAuditable>> {
    - id : Long
    - sentenciado : boolean
    - condenado : boolean
    - tiempoCarcel : int
    - estado : EstadoParticipacionJudicial
    + registrarSentencia(condenado : boolean, meses : int) : void
    + modificarSentencia(condenado : boolean, meses : int) : void
    + extinguirPorFallecimiento() : void
  }
  enum EstadoCasoJudicial {
    EN_TRAMITE
    CERRADO
    REABIERTO_POR_APELACION
  }
  enum EstadoParticipacionJudicial {
    PENDIENTE
    SENTENCIADO
    EXTINGUIDO_POR_FALLECIMIENTO
  }
  Juez "1" -- "0..*" CasoJudicial : interviene
  CasoJudicial "1" *-- "0..*" SentenciaAsaltante : participaciones
  CasoJudicial ..> EstadoCasoJudicial
  SentenciaAsaltante ..> EstadoParticipacionJudicial
}

EntidadAuditable -[hidden]down- Usuario
Vigilante "1" -- "0..*" ContratoVigilancia : cumple
Sucursal "1" -- "0..*" ContratoVigilancia : contrata
Sucursal "1" -- "0..*" Asalto : registra
Asalto "1" -- "0..1" CasoJudicial : origina
Asaltante "1" -- "0..*" SentenciaAsaltante : recibe

@enduml

