-fechaModificacion: LocalDateTime
-creadoPor: String
-modificadoPor: String</panel_attributes><additional_attributes></additional_attributes></element>

  <element><id>UMLClass</id><coordinates><x>40</x><y>430</y><w>400</w><h>270</h></coordinates><panel_attributes>&lt;&lt;abstract&gt;&gt;
